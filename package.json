{
	"name": "tauri-sveltekit",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "npm run tauri dev",
		"build": "npm run tauri build",
		"tauri": "tauri",
		"sveltekit:dev": "vite dev",
		"sveltekit:build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"audit": "npm run audit:frontend && npm run audit:rust",
		"audit:frontend": "npm audit --audit-level=low",
		"audit:rust": "cd src-tauri && cargo audit --deny warnings"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"type": "module"
}
